<% content_for :title, implementation.name %>

<header class="mb-2">
  <h1 class="display-1"><%= implementation.name %></h1>
  <span class="badge bg-<%= implementation_status_color slug %> text-uppercase">
    <%= implementation.status %>
  </span>

  <% if implementation.aliases.present? %>
    <div class="my-3">
      Also known as:

      <% implementation.aliases.each do |other_name| %>
        <abbr class="fst-italic"><%= other_name %></abbr><%= implementation.aliases.last == other_name ? '.' : ',' %>
      <% end %>
    </div>
  <% end %>
</header>

<table id="urls" class="mb-5">
  <tbody>
    <% implementation.urls.each do |name, url| %>
      <tr>
        <th scope="col"><%= link_to name.humanize, url %></th>
        <td class="ps-3"><%= link_to url, url %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<h2 id="versions">Versions</h2>
<table class="table">
  <% versions(slug).each do |version| %>
    <tr>
      <td><%= link_to version, "/#{slug}/#{version}" %></td>
      <td>TODO: DATE</td>
    </tr>
  <% end %>
</table>
